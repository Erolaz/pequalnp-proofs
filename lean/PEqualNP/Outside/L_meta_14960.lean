def allKeys (p : List ℕ → Bool) : BT → Bool
  | .lf => true
  | .nd l k r => allKeys p l && p k && allKeys p r

lemma allKeys_node {p : List ℕ → Bool} {l r : BT} {k : List ℕ}
    (hl : allKeys p l = true) (hk : p k = true) (hr : allKeys p r = true) :
    allKeys p (.nd l k r) = true := by rw [allKeys,hl,hk,hr]; rfl

lemma allKeys_sound (p : List ℕ → Bool) : ∀ T x,
    allKeys p T = true → T.mem x = true → p x = true
  | .lf, _, _, h => by simp [BT.mem] at h
  | .nd l k r, x, h, hm => by
    simp only [allKeys,Bool.and_eq_true] at h
    simp only [BT.mem,Bool.or_eq_true] at hm
    rcases hm with hh|hh
    · obtain rfl := leqL_eq _ _ hh
      exact h.1.2
    · split at hh
      · exact allKeys_sound _ l _ h.1.1 hh
      · exact allKeys_sound _ r _ h.2 hh
