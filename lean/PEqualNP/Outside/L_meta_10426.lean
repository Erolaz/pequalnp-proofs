def net (x : Fin 9 → Bool) : Bool :=
  (x 0 && x 4) || (x 0 && x 6) || (x 2 && x 6) ||
  (x 0 && x 8) || (x 3 && x 8) || (x 6 && x 8)

def base (x : Fin 9 → Bool) : Bool := net x || (x 1 && x 8)

def target (x : Fin 9 → Bool) : Bool :=
  base x || (x 1 && (x 5 || x 7)) || (x 5 && x 7)

def special : Finset (Fin 9) := {5,7}

lemma base_zero (x : Fin 9 → Bool) : base (zeroOn special x) = base x := by
  simp [base, net, zeroOn, special]

lemma base_update5 (x : Fin 9 → Bool) (b : Bool) : base (Function.update x 5 b) = base x := by
  simp [base, net, Function.update_apply]

lemma base_update7 (x : Fin 9 → Bool) (b : Bool) : base (Function.update x 7 b) = base x := by
  simp [base, net, Function.update_apply]

lemma deep_target : DeepHyp target special := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro y hy b
    simp [special] at hy
    rcases hy with rfl | rfl <;> cases b
    all_goals refine ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 4), ?_⟩
    all_goals simp [target,base,net,Function.update_apply]
  · intro y hy z hz hne
    simp [special] at hy hz
    rcases hy with rfl | rfl <;> rcases hz with rfl | rfl
    · exact (hne rfl).elim
    · rintro ⟨a,b,h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 1))
      cases a <;> cases b <;> simp [target,base,net,set2,Function.update_apply] at h0 h1
    · rintro ⟨a,b,h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 1))
      cases a <;> cases b <;> simp [target,base,net,set2,Function.update_apply] at h0 h1
    · exact (hne rfl).elim
  · intro y hy x hx
    have hg : base x = false := by
      have hz : base (zeroOn special x) = false := by simpa [target,zeroOn,special] using hx
      exact (base_zero x).symm.trans hz
    simp [special] at hy
    rcases hy with rfl | rfl
    · let x' := Function.update (Function.update x 5 false) 7 (!x 1)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [special] at hi
        simp [x',Function.update_of_ne hi.1,Function.update_of_ne hi.2]
      · simp [x']
      · simp [target,base_update5,base_update7,x',hg]
      · cases h1 : x 1 <;> simp [target,base_update5,base_update7,x',hg,h1]
    · let x' := Function.update (Function.update x 7 false) 5 (!x 1)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [special] at hi
        simp [x',Function.update_of_ne hi.1,Function.update_of_ne hi.2]
      · simp [x']
      · simp [target,base_update5,base_update7,x',hg]
      · cases h1 : x 1 <;> simp [target,base_update5,base_update7,x',hg,h1]
  · intro x hx
    have hg : base x = true := by
      have hz : base (zeroOn special x) = true := by simpa [target,zeroOn,special] using hx
      exact (base_zero x).symm.trans hz
    simp [target,hg]
  · decide

