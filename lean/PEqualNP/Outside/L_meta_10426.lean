theorem trueF_bound (z : Fin 9) (hz : z = 5 ∨ z = 7) (s : ℕ)
    (h : HasCircuitSize 9 (trueF z) s) : 10 ≤ s := by
  have hd1 : ∃ x : Fin 9 → Bool, trueF z (Function.update x 1 (!x 1)) ≠ trueF z x := by
    rcases hz with rfl | rfl <;> exact ⟨fun _ => false, by decide +kernel⟩
  have hn1 : ∃ x x' : Fin 9 → Bool,
      trueF z (Function.update x 1 false) ≠ trueF z (Function.update x' 1 false) := by
    rcases hz with rfl | rfl
    · exact ⟨fun _ => false, fun i => decide (i = 5), by decide +kernel⟩
    · exact ⟨fun _ => false, fun i => decide (i = 7), by decide +kernel⟩
  obtain ⟨s1, hs1, hc1⟩ := PEqualNP.Outside.L_meta_10426_aux.Elimination.Bow.one_gate_at 8 (trueF z) 1 false s hd1 hn1 h
  let f1 : (Fin 9 → Bool) → Bool := fun x => trueF z (Function.update x 1 false)
  have hd2 : ∃ x : Fin 9 → Bool, f1 (Function.update x z (!x z)) ≠ f1 x := by
    rcases hz with rfl | rfl <;> exact ⟨fun _ => false, by decide +kernel⟩
  have hn2 : ∃ x x' : Fin 9 → Bool,
      f1 (Function.update x z false) ≠ f1 (Function.update x' z false) := by
    rcases hz with rfl | rfl <;>
      exact ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 4), by decide +kernel⟩
  obtain ⟨s2, hs2, hc2⟩ := PEqualNP.Outside.L_meta_10426_aux.Elimination.Bow.one_gate_at 8 f1 z false s1 hd2 hn2 hc1
  let pi : Fin 9 → Fin 6 := ![0,0,4,5,3,0,1,0,2]
  have hrel := PEqualNP.Outside.L_meta_10426_aux.Elimination.Bow.relabel_size pi
    (fun x => f1 (Function.update x z false)) s2 hc2
  have heq : (fun x : Fin 6 → Bool => f1 (Function.update (x ∘ pi) z false)) =
      (fun x : Fin 6 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) ||
        (x 1 && x 2) || (x 1 && x 4) || (x 2 && x 5)) := by
    rcases hz with rfl | rfl <;> funext x <;> revert x <;> decide +kernel
  rw [heq] at hrel
  have h8 := PEqualNP.Outside.L_meta_10426_aux.Small.base_NET s2 hrel
  omega

