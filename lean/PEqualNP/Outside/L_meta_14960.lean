def f (x : Fin 8 → Bool) : Bool :=
  (x 0 && x 4) || (x 1 && x 4) || (x 0 && x 5) || (x 1 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 0 && x 7) || (x 2 && x 7) || (x 3 && x 7) || (x 4 && x 7)

def row (r : ℕ) (i : Fin 8) : Bool := r.testBit i.val

def pinnedOne (x : Fin 8 → Bool) : Bool :=
  f (Function.update x 2 false)

lemma wins_lower (pin : ∀ s, HasCircuitSize 6 pat s → 9 ≤ s) (s : ℕ)
    (h : HasCircuitSize 8 f s) : 11 ≤ s := by
  have dep : ∃ x : Fin 8 → Bool, f (Function.update x 2 (!x 2)) ≠ f x :=
    ⟨row 64, by decide +kernel⟩
  have nc : ∃ x y : Fin 8 → Bool, f (Function.update x 2 false) ≠ f (Function.update y 2 false) :=
    ⟨row 0, row 17, by decide +kernel⟩
  obtain ⟨t, ts, small⟩ := one_gate_at 7 f 2 false s dep nc h
  have dep' : ∃ x : Fin 8 → Bool, pinnedOne (Function.update x 5 (!x 5)) ≠ pinnedOne x :=
    ⟨row 1, by decide +kernel⟩
  have nc' : ∃ x y : Fin 8 → Bool,
      pinnedOne (Function.update x 5 false) ≠ pinnedOne (Function.update y 5 false) :=
    ⟨row 0, row 17, by decide +kernel⟩
  obtain ⟨u, ut, smaller⟩ := one_gate_at 7 pinnedOne 5 false t dep' nc' small
  let pi : Fin 8 → Fin 6 := ![0,1,0,2,3,0,4,5]
  have p := relabel_size pi (fun x => pinnedOne (Function.update x 5 false)) u smaller
  have eqv : (fun x : Fin 6 → Bool => pinnedOne (Function.update (x ∘ pi) 5 false)) = pat := by
    funext x
    revert x
    decide +kernel
  have bound := pin u (eqv ▸ p)
  omega

