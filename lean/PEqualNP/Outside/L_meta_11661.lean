def f (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 4) || (x 0 && x 5) || (x 1 && x 5) || (x 0 && x 6) ||
  (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6) || (x 5 && x 6)

def row (r : ℕ) (i : Fin 7) : Bool := r.testBit i.val

lemma wins_lower (pin : ∀ s, HasCircuitSize 6 pat s → 9 ≤ s) (s : ℕ)
    (h : HasCircuitSize 7 f s) : 10 ≤ s := by
  have dep : ∃ x : Fin 7 → Bool, f (Function.update x 2 (!x 2)) ≠ f x :=
    ⟨row 64, by decide +kernel⟩
  have nc : ∃ x y : Fin 7 → Bool,
      f (Function.update x 2 false) ≠ f (Function.update y 2 false) :=
    ⟨row 0, row 17, by decide +kernel⟩
  obtain ⟨t, ts, small⟩ := one_gate_at 6 f 2 false s dep nc h
  let pi : Fin 7 → Fin 6 := ![0,1,0,2,3,4,5]
  have p := relabel_size pi (fun x => f (Function.update x 2 false)) t small
  have eqv : (fun x : Fin 6 → Bool => f (Function.update (x ∘ pi) 2 false)) = pat := by
    funext x
    revert x
    decide +kernel
  have bound := pin t (eqv ▸ p)
  omega

