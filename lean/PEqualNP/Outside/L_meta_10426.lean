theorem true_bound (y : Fin 9) (hy : y = 5 ∨ y = 7) (s : ℕ)
    (h : HasCircuitSize 9 (fun x => target (Function.update x y true)) s) : 10 ≤ s := by
  rcases hy with rfl | rfl
  · have heq : (fun x : Fin 9 → Bool => target (Function.update x 5 true)) = trueF 7 := by
      funext x
      revert x
      decide +kernel
    rw [heq] at h
    exact trueF_bound 7 (Or.inr rfl) s h
  · have heq : (fun x : Fin 9 → Bool => target (Function.update x 7 true)) = trueF 5 := by
      funext x
      revert x
      decide +kernel
    rw [heq] at h
    exact trueF_bound 5 (Or.inl rfl) s h

