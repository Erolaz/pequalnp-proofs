theorem false_bound (y : Fin 9) (hy : y = 5 ∨ y = 7) (s : ℕ)
    (h : HasCircuitSize 9 (fun x => target (Function.update x y false)) s) : 11 ≤ s := by
  let pi : Fin 9 → Fin 8 := if y = 5 then ![1,3,6,4,5,0,2,7,0] else ![1,3,6,4,5,7,2,0,0]
  have hrel := PEqualNP.Outside.L_meta_10426_aux.Elimination.Bow.relabel_size pi
    (fun x => target (Function.update x y false)) s h
  have heq : (fun x : Fin 8 → Bool => target (Function.update (x ∘ pi) y false)) =
      (fun x : Fin 8 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) ||
        (x 0 && x 4) || (x 1 && x 2) || (x 1 && x 5) || (x 2 && x 6) || (x 3 && x 7)) := by
    rcases hy with rfl | rfl <;> funext x <;> revert x <;> decide +kernel
  rw [heq] at hrel
  exact PEqualNP.Outside.L_meta_10426_aux.cofactorEight s hrel

def trueF (z : Fin 9) (x : Fin 9 → Bool) : Bool := net x || x 1 || x z

